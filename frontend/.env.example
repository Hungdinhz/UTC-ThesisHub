# =====================================================================
# THESIS HUB — FRONTEND ENVIRONMENT CONFIGURATION
# Institution: University of Transport and Communications (UTC)
# Backend: Spring Boot 4.1 + Java 25 + PostgreSQL
# =====================================================================

# Spring Boot REST API Base URL
# - Development (with Vite dev proxy): /api/v1
# - Production (Standalone backend):   https://your-production-domain.com/api/v1
# VITE_API_BASE_URL=https://your-production-domain.com/api/v1

# WebSocket Server Configuration (Real-time chat & notifications)
# - Production WSS endpoint:
# VITE_WS_URL=wss://your-production-domain.com/ws

# ── Local Development ──
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_WS_URL=ws://localhost:8080/ws