# =====================================================================
# THESIS HUB — FRONTEND ENVIRONMENT CONFIGURATION
# Institution: University of Transport and Communications (UTC)
# Backend: Spring Boot 4.1 + Java 25 + PostgreSQL
# =====================================================================

# Spring Boot REST API Base URL
# Development (with Vite dev proxy)
VITE_API_BASE_URL=http://localhost:8080/api/v1

# WebSocket Server Configuration
VITE_WS_URL=ws://localhost:8080/ws

# =========================
# Application
# =========================
VITE_APP_NAME=ThesisHub
VITE_APP_ENV=development

# =========================
# Request
# =========================
VITE_API_TIMEOUT=10000